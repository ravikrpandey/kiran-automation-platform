# Copy to .env for local development. .env is git-ignored; never commit real values.
# Configure only services you control. All credentials and CA material belong in
# this local file or a provider's private environment-variable dashboard, never in chat or GitHub.

NODE_ENV=development
PORT=3000

# Aiven MySQL connection URL. Use TLS certificate verification; do not disable TLS.
DATABASE_URL=
# Aiven project CA PEM material for verified TLS. Keep the downloaded CA private.
MYSQL_SSL_CA=

# Bootstrap a single administrator using the application's approved hash/seed script.
# Store a salted password hash, never a plaintext password.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# SMTP/email is intentionally unconfigured for this demo. Leave empty until a supported
# provider/port is configured. Render Free blocks outbound ports 25, 465, and 587.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cloudflare R2 S3-compatible credentials. Keep the bucket private; until configured,
# resume uploads must remain unavailable (no local-disk or public-bucket fallback).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
